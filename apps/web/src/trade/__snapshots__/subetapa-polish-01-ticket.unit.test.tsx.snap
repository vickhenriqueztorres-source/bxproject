exports[`Subetapa 01 — Ticket com TRADEROOM_POLISH > chave desligada: sala exatamente como antes > HTML idêntico ao snapshot gravado antes da mudança (compacto) 1`] = `"<div class="order-dock-container binmax-order-dock" data-testid="binmax-order-ticket" style="display:flex;flex-direction:column;justify-content:space-between;gap:clamp(2px, 0.4vh, 4px);width:100%;height:100%;max-height:100%;color:var(--text-strong);box-sizing:border-box;overflow:hidden"><div class="binmax-ticket-block" data-testid="ticket-block-monto"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px"><span style="font-size:11px;color:var(--text-muted);font-weight:500;font-family:&#x27;Inter&#x27;, sans-serif">Monto</span><span aria-label="Ayuda monto" style="font-size:9px;color:var(--text-muted);cursor:pointer;width:14px;height:14px;border-radius:50%;border:1px solid rgba(138, 146, 161, 0.4);display:inline-flex;align-items:center;justify-content:center;line-height:1">?</span></div><div style="display:flex;align-items:center;background:#151922;border:1px solid rgba(244, 245, 247, 0.08);border-radius:8px;height:clamp(28px, 3.8vh, 32px);box-sizing:border-box;overflow:hidden"><button type="button" aria-label="Disminuir monto" style="width:26px;height:100%;background:rgba(255, 255, 255, 0.03);border:none;border-right:1px solid rgba(244, 245, 247, 0.06);color:var(--text-muted);font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;transition:color 100ms cubic-bezier(0.16, 1, 0.3, 1)">−</button><div style="flex:1;display:flex;align-items:center;justify-content:center;min-width:0;padding:0 4px;gap:3px"><span style="color:var(--text-quiet);font-size:13px;font-weight:600">$</span><input id="binmax-stake-input" aria-label="Monto de la inversión" inputMode="decimal" style="width:50px;background:none;border:none;outline:none;color:var(--text-strong);font-size:16px;font-weight:700;font-family:&#x27;Geist Mono&#x27;, monospace;font-variant-numeric:tabular-nums;text-align:center" value="100"/></div><button type="button" aria-label="Aumentar monto" style="width:26px;height:100%;background:rgba(255, 255, 255, 0.03);border:none;border-left:1px solid rgba(244, 245, 247, 0.06);color:var(--text-muted);font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;transition:color 100ms cubic-bezier(0.16, 1, 0.3, 1)">+</button></div><div data-testid="stake-presets" style="display:grid;grid-template-columns:repeat(4, 1fr);gap:3px;margin-top:3px"><button type="button" data-testid="preset-10" style="height:20px;border-radius:6px;background:#1A1F2B;border:1px solid rgba(255, 255, 255, 0.08);color:var(--text-muted);font-size:10.5px;font-weight:700;font-family:&#x27;Geist Mono&#x27;, monospace;cursor:pointer;transition:all 100ms cubic-bezier(0.16, 1, 0.3, 1);padding:0">10</button><button type="button" data-testid="preset-50" style="height:20px;border-radius:6px;background:#1A1F2B;border:1px solid rgba(255, 255, 255, 0.08);color:var(--text-muted);font-size:10.5px;font-weight:700;font-family:&#x27;Geist Mono&#x27;, monospace;cursor:pointer;transition:all 100ms cubic-bezier(0.16, 1, 0.3, 1);padding:0">50</button><button type="button" data-testid="preset-100" style="height:20px;border-radius:6px;background:var(--profit);border:1px solid var(--profit);color:#FFFFFF;font-size:10.5px;font-weight:700;font-family:&#x27;Geist Mono&#x27;, monospace;cursor:pointer;transition:all 100ms cubic-bezier(0.16, 1, 0.3, 1);padding:0">100</button><button type="button" data-testid="preset-500" style="height:20px;border-radius:6px;background:#1A1F2B;border:1px solid rgba(255, 255, 255, 0.08);color:var(--text-muted);font-size:10.5px;font-weight:700;font-family:&#x27;Geist Mono&#x27;, monospace;cursor:pointer;transition:all 100ms cubic-bezier(0.16, 1, 0.3, 1);padding:0">500</button></div></div><div class="binmax-ticket-block" data-testid="ticket-block-expiracion" style="position:relative"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px"><span style="font-size:11px;color:var(--text-muted);font-weight:500;font-family:&#x27;Inter&#x27;, sans-serif">Expiración</span><span aria-label="Ayuda expiración" style="font-size:9px;color:var(--text-muted);cursor:pointer;width:14px;height:14px;border-radius:50%;border:1px solid rgba(138, 146, 161, 0.4);display:inline-flex;align-items:center;justify-content:center;line-height:1">?</span></div><div style="display:flex;align-items:center;background:#151922;border:1px solid rgba(244, 245, 247, 0.08);border-radius:8px;height:clamp(28px, 3.8vh, 32px);box-sizing:border-box;overflow:hidden"><button type="button" aria-label="Anterior expiración" style="width:26px;height:100%;background:rgba(255, 255, 255, 0.03);border:none;border-right:1px solid rgba(244, 245, 247, 0.06);color:var(--text-muted);font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;transition:color 100ms cubic-bezier(0.16, 1, 0.3, 1)">−</button><div style="flex:1;display:flex;align-items:center;justify-content:center;cursor:pointer;gap:6px;min-width:0"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-quiet)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg><span style="color:var(--text-strong);font-size:14px;font-weight:700;font-family:&#x27;Geist Mono&#x27;, monospace;font-variant-numeric:tabular-nums">00:50</span></div><button type="button" aria-label="Siguiente expiración" style="width:26px;height:100%;background:rgba(255, 255, 255, 0.03);border:none;border-left:1px solid rgba(244, 245, 247, 0.06);color:var(--text-muted);font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;transition:color 100ms cubic-bezier(0.16, 1, 0.3, 1)">+</button></div></div><div class="binmax-ticket-block" data-testid="ticket-block-ganancia" style="text-align:center;padding:0"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1px"><span style="font-size:10px;color:var(--text-muted);font-weight:500;font-family:&#x27;Inter&#x27;, sans-serif">Ganancia</span><span aria-label="Ayuda ganancia" style="font-size:9px;color:var(--text-muted);cursor:pointer;width:13px;height:13px;border-radius:50%;border:1px solid rgba(138, 146, 161, 0.4);display:inline-flex;align-items:center;justify-content:center;line-height:1">?</span></div><div data-testid="ganancia-pct" style="font-size:18px;font-weight:800;line-height:1.05;color:var(--profit);font-family:&#x27;Geist Mono&#x27;, monospace;letter-spacing:-0.3px">+85%</div><div data-testid="ganancia-amount" style="font-size:11.5px;font-weight:700;color:var(--profit);font-family:&#x27;Geist Mono&#x27;, monospace;margin-top:0">+$85.00</div></div><button type="button" data-testid="btn-sube" aria-label="Operación Sube" style="width:100%;height:clamp(32px, 4.6vh, 38px);border-radius:6px;background:var(--profit);border:none;color:#FFFFFF;cursor:pointer;opacity:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:4px;box-sizing:border-box;box-shadow:0 2px 8px rgba(0, 0, 0, 0.25);transition:transform 0.12s ease, opacity 0.12s ease, background 0.12s ease"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-testid="icon-sube"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg><span style="font-size:12px;font-weight:800;letter-spacing:0.6px;color:#FFFFFF">SUBE</span></button><button type="button" data-testid="btn-baja" aria-label="Operación Baja" style="width:100%;height:clamp(32px, 4.6vh, 38px);border-radius:6px;background:var(--loss);border:none;color:#FFFFFF;cursor:pointer;opacity:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:4px;box-sizing:border-box;box-shadow:0 2px 8px rgba(0, 0, 0, 0.25);transition:transform 0.12s ease, opacity 0.12s ease, background 0.12s ease"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-testid="icon-baja"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg><span style="font-size:12px;font-weight:800;letter-spacing:0.6px;color:#FFFFFF">BAJA</span></button></div>"`;

