{
  "name": "broker-synthetic-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "stack:up": "docker compose -f infra/compose.yaml up -d",
    "stack:down": "docker compose -f infra/compose.yaml down",
    "stack:reset": "docker compose -f infra/compose.yaml down -v && docker compose -f infra/compose.yaml up -d",
    "build": "pnpm -r build",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:chaos": "vitest run tests/chaos",
    "test:load": "k6 run tests/load/k6-broker-load.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "fast-check": "^4.10.2",
    "globals": "17.13.0",
    "prettier": "^3.5.0",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^3.0.5"
  }
}
