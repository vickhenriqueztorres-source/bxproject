# ==============================================================================
# Ambiente da Plataforma de Índices Sintéticos — Binmax (Fase 1 & 2)
# Documentação oficial de todas as flags e variáveis de ambiente (P3-2)
# ==============================================================================

# Ambiente de execução (development | test | production)
NODE_ENV=development
# Nível de log estruturado Pino (debug | info | warn | error)
LOG_LEVEL=info
# Host e porta padrão de serviços HTTP
HOST=0.0.0.0
PORT=3000
# Porta do servidor unificado de feed e API em scripts/dev-live-feed.mjs
DEV_FEED_PORT=3001
# Origem permitida para CORS na API
CORS_ORIGIN=http://localhost:5173
# URL pública do frontend para links de verificação de e-mail e OIDC
APP_PUBLIC_URL=http://localhost:5173

# ==============================================================================
# PostgreSQL da Aplicação
# ==============================================================================
POSTGRES_DB=broker_platform
POSTGRES_USER=synth_migrator
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# String de conexão principal do PostgreSQL
DATABASE_URL=postgres://synth_migrator:your_postgres_password_here@localhost:5432/broker_platform
# String de conexão dedicada do Tick Engine
DATABASE_URL_TICK=postgres://synth_tick_writer:your_postgres_password_here@localhost:5432/broker_platform
# Tamanho máximo do pool de conexões PostgreSQL por processo
DB_POOL_MAX=10

# ==============================================================================
# Redis da Aplicação (Streams, Pub/Sub, Leases e Rate Limit)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# URL completa de conexão com o Redis
REDIS_URL=redis://127.0.0.1:6379

# ==============================================================================
# Keycloak IAM & JWT (Autenticação OIDC e Contas Nativas)
# ==============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_password_here
KEYCLOAK_DB_PASSWORD=your_keycloak_database_password_here
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=broker-demo
KEYCLOAK_CLIENT_ID=broker-api
KEYCLOAK_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_AUDIENCE=broker-api
# Emissor e audiência esperados na validação JWT
JWT_ISSUER=http://localhost:8080/realms/broker-demo
JWT_AUDIENCE=broker-api
# Segredo HMAC para tokens de contas nativas (definir valor aleatório fora do repositório)
JWT_SECRET=

# ==============================================================================
# Blnk Finance Core (Ledger de Partidas Dobradas — P0-1)
# ==============================================================================
# Flag explícita que habilita o Blnk Ledger (true | false). Sem Blnk ativo, contas REAL são recusadas com 503
BLNK_ENABLED=false
# URL base do serviço Blnk Ledger (validada por healthcheck no boot quando BLNK_ENABLED=true)
BLNK_URL=http://localhost:5001
BLNK_PORT=5001
BLNK_POSTGRES_DB=blnk_ledger
BLNK_POSTGRES_USER=blnk_user
BLNK_POSTGRES_PASSWORD=your_blnk_password_here

# ==============================================================================
# Feature Flags do Motor de Mercado, Outbox e Sentimento (P0-2, P2-1)
# ==============================================================================
# Habilita o motor estocástico Ornstein-Uhlenbeck unificado (1 = ativo, 0 = legado)
FEATURE_UNIFIED_OU_ENGINE=1
# Habilita continuidade estatística unificada entre histórico, gap-fill e tempo real (1 = ativo, 0 = desligado)
FEATURE_UNIFIED_CONTINUOUS_MARKET=1
# Habilita gravação de eventos TICK na tabela outbox_events pelo dev-live-feed (true | false; padrão false — Opção B de P0-2)
OUTBOX_WRITE_TICK_EVENTS=false
# Habilita o serviço de sentimento (Traders Mood) em tempo real (true | false)
SENTIMENT_ENABLED=true
# Habilita consulta HTTP externa para cotações ao vivo quando aplicável (true | false)
ENABLE_EXTERNAL_LIVE_HTTP=false
# Chaves opcionais de provedores externos de cotação (manter vazio em modo sintético OTC)
REAL_MARKET_API_KEY=
FCS_API_KEY=
ALLTICK_API_KEY=

# ==============================================================================
# Workers, WebSocket Gateway e Identificadores de Instância
# ==============================================================================
# Símbolo do índice sintético processado pelo worker individual
INDEX_SYMBOL=VOL_100
SYMBOL=VOL_100
TICK_SYMBOL=VOL_100
# Identificadores de consumidor/worker para grupos do Redis Streams
CONSUMER_ID=worker-1
WORKER_ID=settlement-worker-1
# Configuração do WebSocket Gateway distribuído
WS_HOST=0.0.0.0
WS_PORT=8081
WS_NODE_ID=ws-node-1
WS_TOTAL_NODES=1

# ==============================================================================
# E-mail Transacional (SMTP / Resend) e Pagamentos Demo/Fase 2
# ==============================================================================
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=no-reply@brokerproject.local
RESEND_API_KEY=
# Chave PIX estática de demonstração para QR Code Fase 2
PIX_KEY=demo-pix@binmax.local

# ==============================================================================
# Scripts de Diagnóstico, Auditoria e Observabilidade (P0-1, P0-2, P2-2)
# ==============================================================================
# Timestamp ISO inicial para auditoria read-only de consistência de carteira (scripts/diag/wallet-consistency.mjs)
WALLET_AUDIT_SINCE=2026-10-01T00:00:00.000Z
# URL base para medição de correlação de velas (scripts/diag/cross-asset-correlation.mjs)
CANDLES_BASE_URL=http://127.0.0.1:3001
# Parâmetros opcionais dos scripts de diagnóstico de produção
DIAG_BASE_URL=http://127.0.0.1:3001
DIAG_WS_URL=ws://127.0.0.1:3001/ws
DIAG_LIMIT=500
DIAG_OUT_JSON=
DIAG_OUT_TXT=
DIAG_RESTART_CMD=
DIAG_SKIP_RESTART=1
SIM_TRADES=100000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
