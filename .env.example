# Ambiente da Plataforma de Índices Sintéticos (Fase 1)
NODE_ENV=development

# PostgreSQL da Aplicação
POSTGRES_DB=broker_platform
POSTGRES_USER=synth_migrator
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis da Aplicação
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Keycloak IAM
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_password_here
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=broker-demo
KEYCLOAK_CLIENT_ID=broker-api
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# Blnk Finance Core
BLNK_PORT=5001
BLNK_POSTGRES_DB=blnk_ledger
BLNK_POSTGRES_USER=blnk_user
BLNK_POSTGRES_PASSWORD=your_blnk_password_here

# Monitoramento e SMTP Dev
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
